# Copy to apps/api/.env (Bun loads it automatically) and fill in. Never commit real keys.
# Budget and key rules: PLAN.md §2.2. Use your OWN Cerebras dev key locally; the production keys live only in the deploy.

PORT=8787

# Cerebras (gloss translation) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Exa (video context, /discover, /sign-reference) — https://dashboard.exa.ai
EXA_API_KEY=

# SQLite cache file (":memory:" for tests)
DATABASE_URL=./data/signstream.sqlite

# Extra CORS origins, comma separated (youtube.com, chrome-extension://* and localhost are always allowed)
ALLOWED_ORIGINS=

# Secret for ?refresh=1 cache rebuilds (refresh is disabled when empty)
ADMIN_SECRET=

# Abuse limits (protect the sponsor credits)
RATE_LIMIT_NEW_VIDEOS_PER_HOUR=20
RATE_LIMIT_DISCOVER_PER_HOUR=30
MAX_VIDEO_SECONDS=900
