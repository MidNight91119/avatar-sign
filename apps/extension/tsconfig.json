{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": [
      "bun",
      "chrome"
    ],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "manifest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
