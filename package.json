{
  "name": "signstream",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "pr-check": "node .github/scripts/pr-check.ts",
    "eval:gloss": "bun apps/api/src/gloss/eval.ts",
    "signs:missing": "bun apps/api/src/gloss/missing-signs.ts"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24",
    "bun": ">=1.2"
  }
}
